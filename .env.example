# Copy file này thành .env rồi sửa giá trị:  cp .env.example .env
# File .env chứa mật khẩu nên KHÔNG được commit lên Git (đã có trong .gitignore).

DB_NAME=guestbook
DB_USER=guestbook
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me_too

# Hiển thị trên trang web -> dùng để kiểm tra đã deploy phiên bản mới chưa (Lab 5)
APP_VERSION=1.0.0

# 127.0.0.1: chỉ Nginx trên VPS gọi được frontend (an toàn, dùng khi đã cấu hình Nginx)
# 0.0.0.0  : mở http://<VPS_IP>:3000 ra Internet (chỉ dùng tạm để thử ở Lab 3)
PUBLISH_IP=127.0.0.1
